<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_hatchery" model="ir.module.category">
        <field name="name">Incubación</field>
        <field name="description">Datos maestros de la planta de incubación.</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_hatchery_user" model="res.groups">
        <field name="name">Usuario</field>
        <field name="category_id" ref="module_category_hatchery"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Lectura de los datos maestros. No escribe en las máquinas ni en el SCADA.</field>
    </record>

    <record id="group_hatchery_manager" model="res.groups">
        <field name="name">Responsable</field>
        <field name="category_id" ref="module_category_hatchery"/>
        <field name="implied_ids" eval="[(4, ref('group_hatchery_user'))]"/>
        <field name="comment">Crea y modifica los datos maestros en Odoo. No envía cambios a las máquinas.</field>
    </record>

    <record id="base.user_admin" model="res.users">
        <field name="groups_id" eval="[(4, ref('group_hatchery_manager'))]"/>
    </record>

    <record id="hatchery_plant_company_rule" model="ir.rule">
        <field name="name">Planta por compañía</field>
        <field name="model_id" ref="model_hatchery_plant"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="hatchery_machine_company_rule" model="ir.rule">
        <field name="name">Máquina por compañía de la planta</field>
        <field name="model_id" ref="model_hatchery_machine"/>
        <field name="domain_force">[('plant_id.company_id', 'in', company_ids)]</field>
    </record>
    <record id="hatchery_sensor_company_rule" model="ir.rule">
        <field name="name">Sensor por compañía de la planta</field>
        <field name="model_id" ref="model_hatchery_sensor"/>
        <field name="domain_force">[('machine_id.plant_id.company_id', 'in', company_ids)]</field>
    </record>
</odoo>
