<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hatchery_plant_list" model="ir.ui.view">
        <field name="name">hatchery.plant.list</field>
        <field name="model">hatchery.plant</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="tz"/>
                <field name="machine_count"/>
                <field name="installed_capacity_eggs"/>
            </list>
        </field>
    </record>

    <record id="view_hatchery_plant_form" model="ir.ui.view">
        <field name="name">hatchery.plant.form</field>
        <field name="model">hatchery.plant</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Nombre de la planta"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="tz"/>
                        </group>
                        <group string="Indicadores">
                            <field name="machine_count"/>
                            <field name="machine_free_count"/>
                            <field name="machine_loaded_count"/>
                            <field name="machine_cleaning_count"/>
                            <field name="machine_maintenance_count"/>
                            <field name="installed_capacity_eggs"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Máquinas" name="machines">
                            <field name="machine_ids">
                                <list>
                                    <field name="code"/>
                                    <field name="model_id"/>
                                    <field name="kind"/>
                                    <field name="state"/>
                                    <field name="scada_id"/>
                                    <field name="x_pos"/>
                                    <field name="y_pos"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_hatchery_plant_search" model="ir.ui.view">
        <field name="name">hatchery.plant.search</field>
        <field name="model">hatchery.plant</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_company" string="Compañía" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hatchery_plant" model="ir.actions.act_window">
        <field name="name">Plantas</field>
        <field name="res_model">hatchery.plant</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
