<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hatchery_variable_list" model="ir.ui.view">
        <field name="name">hatchery.variable.list</field>
        <field name="model">hatchery.variable</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="unit"/>
            </list>
        </field>
    </record>

    <record id="view_hatchery_variable_form" model="ir.ui.view">
        <field name="name">hatchery.variable.form</field>
        <field name="model">hatchery.variable</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="unit"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_hatchery_variable_search" model="ir.ui.view">
        <field name="name">hatchery.variable.search</field>
        <field name="model">hatchery.variable</field>
        <field name="arch" type="xml">
            <search>
                <field name="code"/>
                <field name="unit"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_code" string="Código" context="{'group_by': 'code'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hatchery_variable" model="ir.actions.act_window">
        <field name="name">Variables</field>
        <field name="res_model">hatchery.variable</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
