<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hatchery_farm_list" model="ir.ui.view">
        <field name="name">hatchery.farm.list</field>
        <field name="model">hatchery.farm</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="kind"/>
                <field name="partner_id"/>
                <field name="senasa_code"/>
                <field name="receiving_capacity_day"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_hatchery_farm_form" model="ir.ui.view">
        <field name="name">hatchery.farm.form</field>
        <field name="model">hatchery.farm</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="active" invisible="1"/>
                    <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Nombre de la granja"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="kind"/>
                            <field name="partner_id"/>
                            <field name="address"/>
                        </group>
                        <group>
                            <field name="senasa_code"/>
                            <field name="receiving_capacity_day"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lotes reproductores" name="flocks">
                            <field name="flock_ids">
                                <list>
                                    <field name="house"/>
                                    <field name="genetic_line"/>
                                    <field name="hatch_date"/>
                                    <field name="age_weeks"/>
                                    <field name="health_status"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_hatchery_farm_search" model="ir.ui.view">
        <field name="name">hatchery.farm.search</field>
        <field name="model">hatchery.farm</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="senasa_code"/>
                <field name="partner_id"/>
                <filter name="kind_breeder" string="Reproductora" domain="[('kind', '=', 'breeder')]"/>
                <filter name="kind_broiler" string="Engorde" domain="[('kind', '=', 'broiler')]"/>
                <filter name="kind_client" string="Cliente" domain="[('kind', '=', 'client')]"/>
                <separator/>
                <filter name="inactive" string="Archivadas" domain="[('active', '=', False)]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_kind" string="Tipo" context="{'group_by': 'kind'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hatchery_farm" model="ir.actions.act_window">
        <field name="name">Granjas</field>
        <field name="res_model">hatchery.farm</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
